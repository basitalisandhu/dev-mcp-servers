{
  "name": "@basitalisandhu/mcp-dockerfile-lint",
  "version": "0.2.2",
  "mcpName": "io.github.basitalisandhu/mcp-dockerfile-lint",
  "description": "MCP server that lints Dockerfiles for root users, latest tags, unpinned base images, secrets in ENV or ARG, missing HEALTHCHECK, apt without cleanup and ADD instead of COPY.",
  "license": "MIT",
  "author": "Muhammad Basit Ali",
  "homepage": "https://github.com/basitalisandhu/dev-mcp-servers/tree/main/packages/dockerfile-lint#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basitalisandhu/dev-mcp-servers.git",
    "directory": "packages/dockerfile-lint"
  },
  "bugs": {
    "url": "https://github.com/basitalisandhu/dev-mcp-servers/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude-code",
    "cursor",
    "dockerfile",
    "docker",
    "lint",
    "containers"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-dockerfile-lint": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "server.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
