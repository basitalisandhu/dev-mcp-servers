{
  "name": "@basitalisandhu/mcp-openapi-lint",
  "version": "0.1.1",
  "mcpName": "io.github.basitalisandhu/mcp-openapi-lint",
  "description": "MCP server that loads an OpenAPI 3.x document and lints it for missing security schemes, operations without responses, unversioned paths and missing descriptions.",
  "license": "MIT",
  "author": "Muhammad Basit Ali",
  "homepage": "https://github.com/basitalisandhu/dev-mcp-servers/tree/main/packages/openapi-lint#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basitalisandhu/dev-mcp-servers.git",
    "directory": "packages/openapi-lint"
  },
  "bugs": {
    "url": "https://github.com/basitalisandhu/dev-mcp-servers/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude-code",
    "cursor",
    "openapi",
    "swagger",
    "lint",
    "api"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-openapi-lint": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "server.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^3.25.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
