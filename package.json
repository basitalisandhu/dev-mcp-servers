{
  "name": "dev-mcp-servers",
  "version": "0.1.1",
  "private": true,
  "description": "Ten small MCP servers for everyday development and security checks, one npm package each.",
  "license": "MIT",
  "author": "Muhammad Basit Ali",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basitalisandhu/dev-mcp-servers.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces && npm run test:scripts",
    "clean": "node -e \"for (const d of require('fs').readdirSync('packages')) require('fs').rmSync('packages/'+d+'/dist', {recursive:true, force:true})\"",
    "check:server-json": "node scripts/check-server-json.mjs",
    "test:scripts": "node --test scripts/check-server-json.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.9.0"
  }
}
